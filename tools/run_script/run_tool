#!/usr/bin/env python3
"""run_tool - run-control + capture orchestrator for the Mu3e SWB/FEB pipeline.

Targets the FEB<->SWB live hit-flow debug path. Performs:
  1. (optional) Program both SOFs.
  2. Wait for FEB SC ring (sc_tool 0x0FE80 -> 0x53434842).
  3. Configure SWB datapath: SWB_LINK_MASK_SCIFI, optional USE_BIT_MERGER.
  4. Reset/stop-reset FEB run control, then configure current-map FEB emulators,
     Type0 arbiters, MTS, rbCAM, and frame assembly path.
  5. Launch dma_tool in background, wait for it to come up.
  6. Issue rc_tool reset -> stop-reset -> run-prepare -> sync -> start-run.
  7. Wait --duration-s.
  8. Issue rc_tool end-run, stop dma_tool.
  9. Read FEB hit-flow CSRs + SWB OPQ counters, write conservation summary.

Designed to be a drop-in companion to the existing sc_tool / rc_tool / dma_tool
binaries - same CLI conventions, same defaults, same exit-code semantics.

Author: yifeng
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import signal
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
DEFAULT_BIN_DIR = SCRIPT_DIR / "build"
DEFAULT_INSTALL_DIR = SCRIPT_DIR / "install" / "bin"
SWB_RING_LOCK_FILE = Path("/tmp/swb_ring.lock")
MUDAQ_DEVICE = "/dev/mudaq0"

# SWB BAR registers are addressed through sc_tool --swb by firmware-true names.
USE_BIT_GEN_LINK = 0x1
USE_BIT_STREAM = 0x2
USE_BIT_MERGER = 0x4  # bit 2 of SWB_READOUT_STATE selects OPQ datapath
USE_BIT_SCIFI = 0x200  # bit 9 selects SciFi readout into the SWB DMA path
USE_BIT_GENERIC = 0x40000  # bit 18 selects generic/development data
DEFAULT_DMA_REQUEST_BLOCKS = 0x80000  # half of a 32 MB dmabuf in 256-bit blocks
DEFAULT_DATAGEN_DIVIDER = 0x10
DEFAULT_GENERIC_MASK = 0x1
SWB_DATAPATH_RESET_MASK = (
    (1 << 1)   # DATAGEN
    | (1 << 2)   # SWB_STREAM_MERGER
    | (1 << 3)   # SWB_TIME_MERGER
    | (1 << 22)  # DATA_PATH
    | (1 << 24)  # FARM_STREAM_MERGER
    | (1 << 25)  # FARM_TIME_MERGER
    | (1 << 26)  # LINK_LOCKED status latch
    | (1 << 28)  # FARM_BLOCK
)
RDMA_CSR_CTRL = 0x08

# FEB SciFi word-addressed CSR windows reachable through the SWB sc_hub.
EMU_BASE_WORD = 0x08800
EMU_STRIDE_WORD = 0x40
ARB_BASE_WORD = 0x08C00
ARB_STRIDE_WORD = 0x20
MTS_BASE_WORDS = (0x09000, 0x0A000)
RBCAM_BASE_WORD = 0x0AC00
RBCAM_BANK_STRIDE_WORD = 0x100
RBCAM_STRIDE_WORD = 0x20
FRAME_ASM_BASE_WORDS = (0x0B400, 0x0B410)
LVDS_CSR_BASE_WORD = 0x08000
LVDS_LANE_GO_WORD = LVDS_CSR_BASE_WORD + 0x04
LVDS_LANE_GO_MASK = 0x000001FF
HIST_CSR_BASE_WORD = 0x0A900
HIST_TOTAL_HITS_WORD = HIST_CSR_BASE_WORD + 0x0D
HIST_DROPPED_HITS_WORD = HIST_CSR_BASE_WORD + 0x0E
EMU_UID = 0x454D5554
ARB_UID = 0x41485430
RBCAM_UID = 0x5242434D
SC_HUB_UID_WORD = 0x0FE80
SC_HUB_UID = 0x53434842

EMU_REG_UID = 0x00
EMU_REG_CENTRAL = 0x07
EMU_REG_SIGNAL = 0x08
EMU_REG_BACKGROUND = 0x09
EMU_REG_FORMAT = 0x0A
EMU_REG_RATES = 0x0B
EMU_REG_CLUSTER_FIX = 0x0C
EMU_REG_PRNG_SEED = 0x0E
EMU_REG_TIMEBASE_SEED = 0x0F

ARB_REG_UID = 0x00
ARB_REG_CONTROL = 0x02
ARB_REG_STATUS = 0x03
ARB_REG_WATCHDOG = 0x04
ARB_REG_INGRESS_REAL_LO = 0x0A
ARB_REG_INGRESS_REAL_HI = 0x0B
ARB_REG_INGRESS_EMU_LO = 0x0C
ARB_REG_INGRESS_EMU_HI = 0x0D
ARB_REG_EGRESS_REAL_LO = 0x12
ARB_REG_EGRESS_EMU_LO = 0x14
ARB_MODE_EMU = 0x1
ARB_CLEAR_ALL = (1 << 2) | (1 << 3) | (1 << 4) | (1 << 5)

EMU_REG_LANE_ENABLE = 0x12
EMU_REG_LANE_STATUS_BASE = 0x18
EMU_FORMAT_TYPE0_SHORT_IDLE = 0x00000033
EMU_CLUSTER_FIX_ALL_CHANNELS = 0x00004F80
MTS_CTRL_DEFAULT = (1 << 0) | (1 << 4) | (1 << 29)
RBCAM_CTRL_DEFAULT = 0x00000011


@dataclass
class Tools:
    sc_tool: Path
    rc_tool: Path
    dma_tool: Path
    swb_ring_lock: Path = Path("/home/yifeng/.local/bin/swb_ring_lock")
    sources: dict[str, str] = field(default_factory=dict)


def _is_executable(path: Path) -> bool:
    return path.exists() and os.access(path, os.X_OK)


def _find_one(name: str, candidates: list[Path]) -> tuple[Path, str] | None:
    for cdir in candidates:
        p = cdir / name
        if _is_executable(p):
            return p, str(cdir)
    found = shutil.which(name)
    if found:
        return Path(found), "PATH"
    return None


def find_tools(tool_bin_dir: Path | None = None, tool_install_dir: Path | None = None) -> Tools:
    """Locate sc/rc/dma_tool, preferring this directory's build output."""
    candidates = [
        tool_bin_dir or DEFAULT_BIN_DIR,
        tool_install_dir or DEFAULT_INSTALL_DIR,
    ]
    found: dict[str, Path] = {}
    sources: dict[str, str] = {}
    for name in ("sc_tool", "rc_tool", "dma_tool"):
        item = _find_one(name, candidates)
        if item is None:
            sys.exit(
                "run_tool: cannot locate "
                f"{name}; checked {', '.join(str(p) for p in candidates)} and PATH"
            )
        found[name], sources[name] = item
    return Tools(**found, sources=sources)


def have_swb_ring_lock() -> bool:
    """True when run_tool inherited the outer swb_ring_lock fd."""
    if os.environ.get("SWB_RING_LOCK_HELD") == "1":
        return True
    try:
        return Path(os.readlink("/proc/self/fd/9")) == SWB_RING_LOCK_FILE
    except OSError:
        return False


def ensure_swb_ring_lock(tools: Tools) -> None:
    """Re-exec the whole orchestrator under the SWB ring lock if needed."""
    if have_swb_ring_lock():
        return
    if not _is_executable(tools.swb_ring_lock):
        sys.exit(f"run_tool: missing required SWB ring lock: {tools.swb_ring_lock}")
    env = os.environ.copy()
    env["SWB_RING_LOCK_HELD"] = "1"
    os.execvpe(
        str(tools.swb_ring_lock),
        [str(tools.swb_ring_lock), sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]],
        env,
    )


def run(cmd: list[str], *, capture: bool = True, check: bool = True) -> subprocess.CompletedProcess[str]:
    res = subprocess.run(cmd, text=True, capture_output=capture)
    if check and res.returncode != 0:
        sys.stderr.write(f"run_tool: command failed rc={res.returncode}: {' '.join(map(str, cmd))}\n")
        if capture:
            sys.stderr.write(res.stdout + res.stderr)
        sys.exit(res.returncode)
    return res


def sc_write(tools: Tools, link: int, addr: int, words: list[int]) -> None:
    args = [
        str(tools.sc_tool),
        str(link),
        "write",
        f"0x{addr:05X}",
        *[f"0x{w & 0xFFFFFFFF:08X}" for w in words],
        "--device",
        MUDAQ_DEVICE,
        "--main-timeout-ms",
        "3000",
        "--reply-timeout-ms",
        "3000",
        "--quiet",
    ]
    last: subprocess.CompletedProcess[str] | None = None
    for attempt in range(6):
        last = run(args, check=False)
        if last.returncode == 0:
            return
        time.sleep(0.05 * (attempt + 1))
    assert last is not None
    sys.stderr.write(f"run_tool: SC write failed after retries at 0x{addr:05X}\n")
    sys.stderr.write(last.stdout + last.stderr)
    sys.exit(last.returncode)


def sc_read(tools: Tools, link: int, addr: int, count: int = 1) -> list[int]:
    args = [
        str(tools.sc_tool),
        str(link),
        "read",
        f"0x{addr:05X}",
        str(count),
        "--device",
        MUDAQ_DEVICE,
        "--main-timeout-ms",
        "3000",
        "--reply-timeout-ms",
        "3000",
        "--quiet",
    ]
    last: subprocess.CompletedProcess[str] | None = None
    for attempt in range(6):
        last = run(args, check=False)
        payloads = re.findall(r"payload\[(\d+)\]\s*=\s*(0x[0-9A-Fa-f]+)", last.stdout + last.stderr)
        if last.returncode == 0 and len(payloads) == count:
            return [int(v, 16) for _, v in payloads]
        time.sleep(0.05 * (attempt + 1))
    assert last is not None
    sys.stderr.write(f"run_tool: SC read 0x{addr:05X} expected {count} words, got no stable reply\n")
    sys.stderr.write(last.stdout + last.stderr)
    sys.exit(last.returncode or 1)


def swb_write(tools: Tools, name: str, val: int) -> None:
    run([
        str(tools.sc_tool),
        "--swb",
        "write",
        name,
        f"0x{val & 0xFFFFFFFF:08X}",
    ], capture=False, check=True)


def swb_read(tools: Tools, name: str) -> int:
    res = run([str(tools.sc_tool), "--swb", "read", name])
    match = re.search(r"^[A-Za-z0-9_+xX]+=(0x[0-9A-Fa-f]+)", res.stdout, re.MULTILINE)
    if not match:
        sys.exit(f"run_tool: sc_tool --swb read {name} returned no value")
    return int(match.group(1), 16)


def swb_dump_all(tools: Tools) -> str:
    return run([str(tools.sc_tool), "--swb", "dump-all"]).stdout.rstrip()


def rc_send(tools: Tools, cmd: str, *, run_no: int | None = None, feb: int = 7) -> None:
    args = [str(tools.rc_tool), "send", cmd, "--device", MUDAQ_DEVICE, "--feb", str(feb)]
    if run_no is not None:
        args.extend(["--run", str(run_no)])
    run(args, capture=False, check=False)  # rc_tool prints to stderr


def sc_write_stable(tools: Tools, link: int, addr: int, words: list[int]) -> None:
    # The live SC bridge can occasionally echo the previous write on the first
    # transaction after an address change.  Repeating the same write is the
    # established board-test pattern for deterministic CSR programming.
    sc_write(tools, link, addr, words)
    sc_write(tools, link, addr, words)


def try_sc_read(tools: Tools, link: int, addr: int, count: int = 1) -> tuple[list[int] | None, str | None]:
    try:
        return sc_read(tools, link, addr, count), None
    except SystemExit as exc:
        return None, f"read failed rc={exc.code}"


def wait_for_feb(tools: Tools, link: int, *, timeout_s: float = 30.0, expected_uid: int = SC_HUB_UID) -> None:
    deadline = time.time() + timeout_s
    while time.time() < deadline:
        try:
            uid = sc_read(tools, link, SC_HUB_UID_WORD)[0]
            if uid == expected_uid:
                return
        except SystemExit:
            pass
        time.sleep(2)
    sys.exit(f"run_tool: FEB SC ring did not stabilize (UID {expected_uid:#x}) after {timeout_s}s")


def rdma_csr_write(tools: Tools, addr: int, value: int) -> None:
    """Write the SWB-local rdma_subsystem CSR shim."""
    swb_write(tools, "SWB_LOOKUP_CTRL_REGISTER_W", addr & 0xFF)
    swb_write(tools, "SWB_LOOKUP_DS_CTRL_REGISTER_W", value & 0xFFFFFFFF)


def rdma_observability(tools: Tools) -> dict[str, int]:
    """Read rdma_pretest bridge counters exposed on legacy SWB RO registers."""
    return {
        "STATUS": swb_read(tools, "EVENT_BUILD_STATUS_REGISTER_R"),
        "CNT_OPQ_INPUT_W": swb_read(tools, "EVENT_BUILD_IDLE_NOT_HEADER_R"),
        "CNT_BYTES_WRITTEN": swb_read(tools, "EVENT_BUILD_SKIP_EVENT_DMA_R"),
        "CNT_RQE_CONSUMED": swb_read(tools, "EVENT_BUILD_CNT_EVENT_DMA_R"),
        "CNT_CQE_POSTED": swb_read(tools, "EVENT_BUILD_TAG_FIFO_FULL_R"),
        "CNT_HALT": swb_read(tools, "BUFFER_STATUS_REGISTER_R"),
        "CNT_EOE_OBSERVED": swb_read(tools, "DMA_CNT_WORDS_REGISTER_R"),
    }


def configure_swb(tools: Tools, *, link_mask_scifi: int, use_opq: bool, gen_link: bool = False) -> dict:
    """Set SWB datapath. Returns the resulting register snapshot."""
    swb_write(tools, "RESET_REGISTER_W", SWB_DATAPATH_RESET_MASK)
    swb_write(tools, "SWB_LINK_MASK_SCIFI", link_mask_scifi)
    if gen_link:
        swb_write(tools, "SWB_GENERIC_MASK_REGISTER_W", DEFAULT_GENERIC_MASK)
        state = USE_BIT_GENERIC | USE_BIT_MERGER | USE_BIT_GEN_LINK
        swb_write(tools, "DATAGENERATOR_DIVIDER_REGISTER_W", DEFAULT_DATAGEN_DIVIDER)
    else:
        swb_write(tools, "SWB_GENERIC_MASK_REGISTER_W", 0x0)
        state = USE_BIT_SCIFI | (USE_BIT_MERGER if use_opq else USE_BIT_STREAM)
    swb_write(tools, "SWB_READOUT_STATE", state)
    swb_write(tools, "FARM_READOUT_STATE", state)
    swb_write(tools, "GET_N_DMA_WORDS_REGISTER_W", DEFAULT_DMA_REQUEST_BLOCKS)
    time.sleep(0.01)
    swb_write(tools, "RESET_REGISTER_W", 0x0)
    if gen_link:
        rdma_csr_write(tools, RDMA_CSR_CTRL, 0x00000002)
        rdma_csr_write(tools, RDMA_CSR_CTRL, 0x00000001)
    swb_write(tools, "DMA_REGISTER", 0x1)
    time.sleep(0.1)
    return {
        "RESET_REGISTER_W": swb_read(tools, "RESET_REGISTER_W"),
        "DATAGENERATOR_DIVIDER_REGISTER_W": swb_read(tools, "DATAGENERATOR_DIVIDER_REGISTER_W"),
        "SWB_GENERIC_MASK_REGISTER_W": swb_read(tools, "SWB_GENERIC_MASK_REGISTER_W"),
        "SWB_LINK_MASK_SCIFI": swb_read(tools, "SWB_LINK_MASK_SCIFI"),
        "SWB_READOUT_STATE": swb_read(tools, "SWB_READOUT_STATE"),
        "FARM_READOUT_STATE": swb_read(tools, "FARM_READOUT_STATE"),
        "RDMA": rdma_observability(tools),
        "GET_N_DMA_WORDS_REGISTER_W": swb_read(tools, "GET_N_DMA_WORDS_REGISTER_W"),
        "DMA_REGISTER": swb_read(tools, "DMA_REGISTER"),
    }


def _read_counter64(tools: Tools, link: int, base: int, low_reg: int) -> int:
    low, high = sc_read(tools, link, base + low_reg, 2)
    return (high << 32) | low


def _u48(high_word: int, low_word: int, *, high_bits: int = 18) -> int:
    return ((high_word & ((1 << high_bits) - 1)) << 32) | (low_word & 0xFFFFFFFF)


def configure_current_feb_sources(tools: Tools, link: int, *, q16_rate: int, lane_mask: int = 0xFF) -> dict:
    """Configure the current FEB v3 SC word map for Type0 emulator hit delivery."""
    record: dict = {
        "lvds_lane_go": {},
        "emulators": [],
        "type0_arbs": [],
        "mts": [],
        "rbcam": [],
        "lane_mask": f"0x{lane_mask & 0xFF:02X}",
        "q16_rate": q16_rate & 0xFFFF,
    }

    sc_write_stable(tools, link, LVDS_LANE_GO_WORD, [LVDS_LANE_GO_MASK])
    lane_go = sc_read(tools, link, LVDS_LANE_GO_WORD)[0]
    record["lvds_lane_go"] = {
        "addr": f"0x{LVDS_LANE_GO_WORD:05X}",
        "requested": f"0x{LVDS_LANE_GO_MASK:08X}",
        "observed": f"0x{lane_go:08X}",
    }

    for lane in range(8):
        base = EMU_BASE_WORD + lane * EMU_STRIDE_WORD
        uid = sc_read(tools, link, base + EMU_REG_UID, 1)[0]
        if uid != EMU_UID:
            sys.exit(f"run_tool: emulator_mutrig_{lane} UID mismatch at 0x{base:05X}: 0x{uid:08X}")
        enabled = 1 if ((lane_mask >> lane) & 0x1) else 0
        sc_write_stable(tools, link, base + EMU_REG_CENTRAL, [0x00000000])
        sc_write_stable(tools, link, base + EMU_REG_BACKGROUND, [0x00000000])
        sc_write_stable(tools, link, base + EMU_REG_SIGNAL, [0x00000002])
        sc_write_stable(tools, link, base + EMU_REG_FORMAT, [EMU_FORMAT_TYPE0_SHORT_IDLE])
        sc_write_stable(tools, link, base + EMU_REG_RATES, [q16_rate & 0xFFFF])
        sc_write_stable(tools, link, base + EMU_REG_CLUSTER_FIX, [EMU_CLUSTER_FIX_ALL_CHANNELS])
        sc_write_stable(tools, link, base + EMU_REG_PRNG_SEED, [0xDEADBEEF ^ lane])
        sc_write_stable(tools, link, base + EMU_REG_TIMEBASE_SEED, [0x00010001])
        sc_write_stable(tools, link, base + EMU_REG_LANE_ENABLE, [((lane & 0xF) << 8) | enabled])
        if enabled:
            sc_write_stable(tools, link, base + EMU_REG_CENTRAL, [0x00000001])
        record["emulators"].append({
            "lane": lane,
            "base": f"0x{base:05X}",
            "uid": f"0x{uid:08X}",
            "enabled": bool(enabled),
            "central": f"0x{sc_read(tools, link, base + EMU_REG_CENTRAL)[0]:08X}",
            "signal": f"0x{sc_read(tools, link, base + EMU_REG_SIGNAL)[0]:08X}",
            "format": f"0x{sc_read(tools, link, base + EMU_REG_FORMAT)[0]:08X}",
            "rates": f"0x{sc_read(tools, link, base + EMU_REG_RATES)[0]:08X}",
            "lane_enable": f"0x{sc_read(tools, link, base + EMU_REG_LANE_ENABLE)[0]:08X}",
        })

    for lane in range(8):
        base = ARB_BASE_WORD + lane * ARB_STRIDE_WORD
        uid = sc_read(tools, link, base + ARB_REG_UID, 1)[0]
        if uid != ARB_UID:
            sys.exit(f"run_tool: arb_hit_type0_{lane} UID mismatch at 0x{base:05X}: 0x{uid:08X}")
        sc_write_stable(tools, link, base + ARB_REG_WATCHDOG, [0x000001F4])
        sc_write_stable(tools, link, base + ARB_REG_CONTROL, [ARB_MODE_EMU | ARB_CLEAR_ALL])
        record["type0_arbs"].append({
            "lane": lane,
            "base": f"0x{base:05X}",
            "uid": f"0x{uid:08X}",
            "control": f"0x{sc_read(tools, link, base + ARB_REG_CONTROL)[0]:08X}",
            "status": f"0x{sc_read(tools, link, base + ARB_REG_STATUS)[0]:08X}",
            "watchdog": f"0x{sc_read(tools, link, base + ARB_REG_WATCHDOG)[0]:08X}",
        })

    for idx, base in enumerate(MTS_BASE_WORDS):
        sc_write_stable(tools, link, base, [MTS_CTRL_DEFAULT])
        record["mts"].append({
            "idx": idx,
            "base": f"0x{base:05X}",
            "control": f"0x{sc_read(tools, link, base)[0]:08X}",
        })

    for stack_name, base0 in (("lower", RBCAM_BASE_WORD), ("upper", RBCAM_BASE_WORD + RBCAM_BANK_STRIDE_WORD)):
        for lane in range(4):
            base = base0 + lane * RBCAM_STRIDE_WORD
            uid = sc_read(tools, link, base, 1)[0]
            if uid != RBCAM_UID:
                sys.exit(f"run_tool: ring_buffer_cam {stack_name}{lane} UID mismatch at 0x{base:05X}: 0x{uid:08X}")
            sc_write_stable(tools, link, base + 2, [RBCAM_CTRL_DEFAULT])
            record["rbcam"].append({
                "stack": stack_name,
                "lane": lane,
                "base": f"0x{base:05X}",
                "uid": f"0x{uid:08X}",
                "control": f"0x{sc_read(tools, link, base + 2)[0]:08X}",
            })
    return record


def configure_empty_frame_sources(tools: Tools, link: int) -> dict:
    """Configure the current FEB source path for empty frames / zero generated hits."""
    return configure_current_feb_sources(tools, link, q16_rate=0, lane_mask=0xFF)


def read_feb_flow_counters(tools: Tools, link: int) -> dict:
    arbs = []
    for lane in range(8):
        base = ARB_BASE_WORD + lane * ARB_STRIDE_WORD
        ingress_real = _read_counter64(tools, link, base, ARB_REG_INGRESS_REAL_LO)
        ingress_emu = _read_counter64(tools, link, base, ARB_REG_INGRESS_EMU_LO)
        egress_real = _read_counter64(tools, link, base, ARB_REG_EGRESS_REAL_LO)
        egress_emu = _read_counter64(tools, link, base, ARB_REG_EGRESS_EMU_LO)
        arbs.append({
            "lane": lane,
            "base": f"0x{base:05X}",
            "status": f"0x{sc_read(tools, link, base + ARB_REG_STATUS)[0]:08X}",
            "ingress_real_hits": ingress_real,
            "ingress_emu_hits": ingress_emu,
            "egress_real_hits": egress_real,
            "egress_emu_hits": egress_emu,
            "egress_hits": egress_real + egress_emu,
        })

    mts = []
    for idx, base in enumerate(MTS_BASE_WORDS):
        words = sc_read(tools, link, base, 5)
        mts.append({
            "idx": idx,
            "base": f"0x{base:05X}",
            "control_status": f"0x{words[0]:08X}",
            "discard_hits": words[1],
            "expected_latency": words[2],
            "total_hits": ((words[3] & 0xFFFF) << 32) | words[4],
        })

    rbcam = []
    for stack_name, base0 in (("lower", RBCAM_BASE_WORD), ("upper", RBCAM_BASE_WORD + RBCAM_BANK_STRIDE_WORD)):
        for lane in range(4):
            base = base0 + lane * RBCAM_STRIDE_WORD
            words = sc_read(tools, link, base, 10)
            rbcam.append({
                "stack": stack_name,
                "lane": lane,
                "base": f"0x{base:05X}",
                "uid": f"0x{words[0]:08X}",
                "control": f"0x{words[2]:08X}",
                "fill_level": words[4],
                "inerr_count": words[5],
                "push_count": words[6],
                "pop_count": words[7],
                "overwrite_count": words[8],
                "cache_miss_count": words[9],
            })

    frame_asm = []
    for idx, base in enumerate(FRAME_ASM_BASE_WORDS):
        words = sc_read(tools, link, base, 8)
        frame_asm.append({
            "idx": idx,
            "base": f"0x{base:05X}",
            "feb_type": words[0],
            "feb_id": words[1],
            "declared_hits": _u48(words[2], words[3]),
            "actual_hits": _u48(words[4], words[5]),
            "missing_hits": _u48(words[6], words[7]),
        })

    return {
        "type0_arb": arbs,
        "type0_arb_sums": {
            "ingress_real_hits": sum(row["ingress_real_hits"] for row in arbs),
            "ingress_emu_hits": sum(row["ingress_emu_hits"] for row in arbs),
            "egress_hits": sum(row["egress_hits"] for row in arbs),
        },
        "mts": mts,
        "mts_sums": {
            "discard_hits": sum(row["discard_hits"] for row in mts),
            "total_hits": sum(row["total_hits"] for row in mts),
        },
        "rbcam": rbcam,
        "rbcam_sums": {
            "push_count": sum(row["push_count"] for row in rbcam),
            "pop_count": sum(row["pop_count"] for row in rbcam),
            "cache_miss_count": sum(row["cache_miss_count"] for row in rbcam),
        },
        "frame_asm": frame_asm,
        "frame_asm_sums": {
            "declared_hits": sum(row["declared_hits"] for row in frame_asm),
            "actual_hits": sum(row["actual_hits"] for row in frame_asm),
            "missing_hits": sum(row["missing_hits"] for row in frame_asm),
        },
    }


def _fmt_words(words: list[int]) -> str:
    return " ".join(f"0x{word & 0xFFFFFFFF:08X}" for word in words)


def dump_csrs(tools: Tools, link: int, out_dir: Path) -> Path:
    stamp = dt.datetime.now().strftime("%Y%m%d_%H%M%S")
    path = out_dir / f"run_tool_csr_dump_{stamp}.md"

    swb_dump = swb_dump_all(tools)
    feb_ranges = [
        *[(f"emulator_mutrig_{idx}.csr", EMU_BASE_WORD + idx * EMU_STRIDE_WORD, 16) for idx in range(8)],
        *[(f"arb_hit_type0_{idx}.csr", ARB_BASE_WORD + idx * ARB_STRIDE_WORD, 32) for idx in range(8)],
        *[(f"mutrig_timestamp_processor_{idx}.csr", base, 8) for idx, base in enumerate(MTS_BASE_WORDS)],
        *[(f"ring_buffer_cam_lower_{idx}.csr", RBCAM_BASE_WORD + idx * RBCAM_STRIDE_WORD, 10) for idx in range(4)],
        *[(f"ring_buffer_cam_upper_{idx}.csr", RBCAM_BASE_WORD + RBCAM_BANK_STRIDE_WORD + idx * RBCAM_STRIDE_WORD, 10) for idx in range(4)],
        *[(f"feb_frame_assembly_{idx}.csr", base, 8) for idx, base in enumerate(FRAME_ASM_BASE_WORDS)],
        ("histogram_statistics_0.csr", HIST_CSR_BASE_WORD, 17),
    ]

    lines = [
        "# run_tool CSR Dump",
        "",
        f"- Created: {dt.datetime.now().isoformat(timespec='seconds')}",
        f"- sc_tool: `{tools.sc_tool}`",
        f"- FEB link: `{link}`",
        "",
        "## SWB BAR0 Registers",
        "",
        "Generated by `sc_tool --swb dump-all`.",
        "",
        swb_dump,
    ]

    lines.extend([
        "",
        "## FEB SC CSR Ranges",
        "",
        "| Name | Word Base | Words | Values | Status |",
        "|---|---:|---:|---|---|",
    ])
    for name, base, count in feb_ranges:
        words, err = try_sc_read(tools, link, base, count)
        values = "n/a" if words is None else _fmt_words(words)
        lines.append(f"| `{name}` | `0x{base:05X}` | {count} | `{values}` | {'OK' if err is None else err} |")

    path.write_text("\n".join(lines) + "\n", encoding="ascii")
    return path


def parse_dma_summary(dma_log: Path) -> dict[str, int | str]:
    if not dma_log.exists():
        return {}
    text = dma_log.read_text(errors="replace")
    match = re.search(
        r"summary: read_words=(\d+)\s+written_words=(\d+)\s+bytes_written=(\d+)\s+"
        r"DMA_CNT_WORDS_REGISTER_R=(\d+)\s+output=(\S+)",
        text,
    )
    if not match:
        return {}
    return {
        "read_words": int(match.group(1)),
        "written_words": int(match.group(2)),
        "bytes_written": int(match.group(3)),
        "dma_cnt_words_register": int(match.group(4)),
        "output": match.group(5),
    }


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    run_group = ap.add_argument_group("Run controls")
    run_group.add_argument("--duration-s", type=int, default=5, help="run duration after start-run (default 5)")
    run_group.add_argument("--rate-q16", type=int, default=52, help="emulator hit_rate q16 (default 52 = ~100k preset)")
    run_group.add_argument("--output-dir", type=Path, default=Path("/tmp/run_tool"))
    run_group.add_argument("--feb-link", type=int, default=2)
    run_group.add_argument("--feb-target", type=int, default=7)
    run_group.add_argument("--feb-sof", type=Path, default=None, help="program FEB before run (optional)")
    run_group.add_argument("--feb-settle-seconds", type=int, default=20,
                           help="post-FEB-program settle (>=20 mandatory; SC reads in window return trash; default 20)")
    run_group.add_argument("--swb-sof", type=Path, default=None, help="program SWB before run (optional)")
    run_group.add_argument("--skip-program", "--no-program", dest="skip_program", action="store_true",
                           help="skip SOF programming and assume hardware is already configured")
    run_group.add_argument("--skip-feb-config", action="store_true", help="don't configure the FEB emulator/Type0/MTS/rbCAM source path")
    run_group.add_argument("--use-opq", action="store_true", help="enable USE_BIT_MERGER (OPQ datapath); default off")
    run_group.add_argument("--swb-link-mask-scifi", type=lambda s: int(s, 0), default=0x4)
    run_group.add_argument("--staging-mb", type=int, default=64)
    run_group.add_argument("--af-pct", type=int, default=80)

    debug_group = ap.add_argument_group("Debug smoke modes")
    debug_group.add_argument("--empty-frame", action="store_true",
                             help="configure FEB emulator sources for header/empty frames with zero generated hits")
    debug_group.add_argument("--skip-mutrig-config", action="store_true",
                             help="skip any real-MuTRiG XML/JTAG configure step; emulator traffic is still allowed")
    debug_group.add_argument("--no-data-ingress", action="store_true",
                             help="force SWB_LINK_MASK_SCIFI=0 and run SWB generated generic data through OPQ/RDMA")
    debug_group.add_argument("--dump-csrs", action="store_true",
                             help="write run_tool_csr_dump_<timestamp>.md with SWB BAR0 registers and FEB hit-flow CSR ranges")

    tool_group = ap.add_argument_group("Tool discovery")
    tool_group.add_argument("--tool-bin-dir", type=Path, default=None,
                            help=f"directory containing sc_tool/rc_tool/dma_tool (default {DEFAULT_BIN_DIR})")
    tool_group.add_argument("--tool-install-dir", type=Path, default=None,
                            help=f"secondary tool directory (default {DEFAULT_INSTALL_DIR})")
    tool_group.add_argument("--refresh-tool-paths", action="store_true",
                            help="refresh tool lookup from the local build/install dirs and PATH")
    args = ap.parse_args()

    tools = find_tools(args.tool_bin_dir, args.tool_install_dir)
    ensure_swb_ring_lock(tools)
    args.output_dir.mkdir(parents=True, exist_ok=True)
    summary: dict = {
        "started_at": time.time(),
        "args": {k: str(v) for k, v in vars(args).items()},
        "tools": {name: str(path) for name, path in tools.__dict__.items() if isinstance(path, Path)},
        "tool_sources": tools.sources,
        "swb_ring_lock": str(tools.swb_ring_lock),
    }

    # 1. Program (optional)
    if not args.skip_program:
        if args.swb_sof:
            print(f"run_tool: programming SWB {args.swb_sof}")
            run(["quartus_pgm", "-c", "DE5 [3-6.2]", "-m", "JTAG", "-o", f"p;{args.swb_sof}@1"], capture=False)
            run(["sudo", "-n", "/usr/local/sbin/mudaq_recover_pcie"], capture=False)
            time.sleep(2)
        if args.feb_sof:
            print(f"run_tool: programming FEB {args.feb_sof}")
            run(["quartus_pgm", "-c", "USB-BlasterII [7-2]", "-m", "JTAG", "-o", f"p;{args.feb_sof}@1"], capture=False)
            # FEB LVDS PLL + firefly transceiver word-alignment need ~20s after
            # FPGA configuration before SC packets can be issued safely. SC reads
            # during the settle window return clean-looking trash that the SWB
            # secondary ring parses as floods of "invalid RD/WR" packets with
            # bogus addresses (50k+ word secondary delta). Confirmed empirically
            # 2026-05-11. See ~/.claude/.../feedback_feb_post_program_settle.md.
            settle = int(getattr(args, "feb_settle_seconds", 20))
            if settle < 20:
                print(f"run_tool: WARNING --feb-settle-seconds={settle} is below the 20 s minimum; "
                      f"SC reads issued in the settle window return trash. See README.")
            print(f"run_tool: waiting {settle} s for FEB LVDS PLL + firefly transceiver to settle")
            time.sleep(settle)

    # 2. Wait for FEB SC ring
    wait_for_feb(tools, args.feb_link)
    print("run_tool: FEB SC ring up")
    if args.skip_mutrig_config or args.empty_frame:
        print("run_tool: MuTRiG XML/JTAG configure step skipped")
        summary["mutrig_config"] = "skipped"

    # 3. SWB config
    link_mask_scifi = 0 if args.no_data_ingress else args.swb_link_mask_scifi
    if args.no_data_ingress:
        print(
            "run_tool: --no-data-ingress active; forcing SWB_LINK_MASK_SCIFI=0x00000000 "
            "and enabling the SWB generated generic lane through OPQ/RDMA"
        )
    swb_state = configure_swb(
        tools,
        link_mask_scifi=link_mask_scifi,
        use_opq=args.use_opq,
        gen_link=args.no_data_ingress,
    )
    print(f"run_tool: SWB state {swb_state}")
    summary["swb_state"] = swb_state

    run_no = int(time.time()) & 0xFFFFFF
    summary["run_number"] = run_no
    print(f"run_tool: rc_tool preamble reset/stop-reset run={run_no}")
    rc_send(tools, "reset", feb=args.feb_target)
    rc_send(tools, "stop-reset", feb=args.feb_target)

    # 4. FEB config on the current v3 SC word map.  The stale 20260427 helper
    # used a different emulator stride and is intentionally not called here.
    if args.empty_frame:
        print("run_tool: configuring empty-frame FEB source mode (no MuTRiG config, no emulator hits)")
        summary["empty_frame_config"] = configure_empty_frame_sources(tools, args.feb_link)
    elif not args.skip_feb_config:
        print("run_tool: configuring current FEB Type0 emulator source path")
        summary["feb_config"] = configure_current_feb_sources(
            tools,
            args.feb_link,
            q16_rate=args.rate_q16,
            lane_mask=0xFF,
        )

    # 5. Launch dma_tool
    dma_log = args.output_dir / "dma_tool.log"
    dma_out = args.output_dir / "capture.bin"
    print(f"run_tool: launching dma_tool -> {dma_out}")
    dma_proc = subprocess.Popen(
        [
            str(tools.dma_tool),
            "--duration-s", "0",  # 0 = until SIGINT
            "--staging-mb", str(args.staging_mb),
            "--af-pct", str(args.af_pct),
            "--out", str(dma_out),
        ],
        stdout=open(dma_log, "wb"),
        stderr=subprocess.STDOUT,
        preexec_fn=os.setsid,
    )
    time.sleep(1)
    if dma_proc.poll() is not None:
        sys.exit(f"run_tool: dma_tool exited prematurely; see {dma_log}")

    try:
        # 6. Run-control sequence
        print(f"run_tool: rc_tool sequence run={run_no}")
        rc_send(tools, "run-prepare", run_no=run_no, feb=args.feb_target)
        rc_send(tools, "sync", feb=args.feb_target)
        rc_send(tools, "start-run", feb=args.feb_target)

        # 7. Wait
        print(f"run_tool: running for {args.duration_s} s")
        time.sleep(args.duration_s)

        # 8. End-run + stop dma_tool
        rc_send(tools, "end-run", feb=args.feb_target)
        time.sleep(0.5)
    finally:
        os.killpg(os.getpgid(dma_proc.pid), signal.SIGINT)
        try:
            dma_proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            os.killpg(os.getpgid(dma_proc.pid), signal.SIGKILL)
            dma_proc.wait()

    # 9. Read counters / hist
    final_state = {
        "RESET_REGISTER_W": swb_read(tools, "RESET_REGISTER_W"),
        "DATAGENERATOR_DIVIDER_REGISTER_W": swb_read(tools, "DATAGENERATOR_DIVIDER_REGISTER_W"),
        "SWB_GENERIC_MASK_REGISTER_W": swb_read(tools, "SWB_GENERIC_MASK_REGISTER_W"),
        "SWB_LINK_MASK_SCIFI": swb_read(tools, "SWB_LINK_MASK_SCIFI"),
        "SWB_READOUT_STATE": swb_read(tools, "SWB_READOUT_STATE"),
        "FARM_READOUT_STATE": swb_read(tools, "FARM_READOUT_STATE"),
        "RDMA": rdma_observability(tools),
        "GET_N_DMA_WORDS_REGISTER_W": swb_read(tools, "GET_N_DMA_WORDS_REGISTER_W"),
        "DMA_REGISTER": swb_read(tools, "DMA_REGISTER"),
    }
    summary["final_swb_state"] = final_state
    try:
        summary["final_feb_flow"] = read_feb_flow_counters(tools, args.feb_link)
    except SystemExit as exc:
        summary["final_feb_flow"] = {"error": f"read failed rc={exc.code}"}
    summary["dma_capture_bytes"] = dma_out.stat().st_size if dma_out.exists() else 0
    summary["dma_log"] = str(dma_log)
    if dma_log.exists():
        summary["dma_summary"] = dma_log.read_text().splitlines()[-3:]
        summary["dma_counters"] = parse_dma_summary(dma_log)

    # FEB histogram total/drop counters in the current histogram_statistics CSR layout.
    try:
        hist0 = sc_read(tools, args.feb_link, HIST_TOTAL_HITS_WORD)[0]
        hist0_drops = sc_read(tools, args.feb_link, HIST_DROPPED_HITS_WORD)[0]
        summary["hist_0_total_hits"] = hist0
        summary["hist_0_dropped_hits"] = hist0_drops
    except SystemExit:
        summary["hist_0_total_hits"] = "<read failed>"

    if args.dump_csrs:
        csr_dump_path = dump_csrs(tools, args.feb_link, args.output_dir)
        summary["csr_dump"] = str(csr_dump_path)
        print(f"run_tool: CSR dump at {csr_dump_path}")

    summary["finished_at"] = time.time()
    summary_path = args.output_dir / "debug_daq_summary.json"
    summary_path.write_text(json.dumps(summary, indent=2))
    print(f"run_tool: summary at {summary_path}")
    print(f"  capture file:    {dma_out} ({summary['dma_capture_bytes']} bytes)")
    if summary.get("dma_counters"):
        print(f"  dma counters:    {summary['dma_counters']}")
    print(f"  hist_0 total:    {summary.get('hist_0_total_hits')}")
    print(f"  hist_0 drops:    {summary.get('hist_0_dropped_hits')}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
