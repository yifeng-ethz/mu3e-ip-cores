set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name QIP_FILE top.qip
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE util/quartus/settings.tcl
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE assignments/fe_a5_base.tcl
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE assignments/fe_v2_scifi_pins.tcl

# Round 2 emulator-type0 timing closure keeps Standard Fit but biases the
# build-local image toward setup timing before the final board retest.
set_global_assignment -name NUM_PARALLEL_PROCESSORS 16
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name ROUTER_TIMING_OPTIMIZATION_LEVEL MAXIMUM
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name PHYSICAL_SYNTHESIS_EFFORT NORMAL

set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Standard Edition"

# Project-wide VHDL-2008 input: needed for util_pkg (integer_vector) and
# for the hist v2 IP family. Per-file magic comments
# (-- altera vhdl_input_version vhdl_2008) are honored separately.
set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008



set_global_assignment -name USE_SIGNALTAP_FILE mutrig_cfg_lvds.stp
set_global_assignment -name ENABLE_SIGNALTAP ON
set_global_assignment -name ENABLE_LOGIC_ANALYZER_INTERFACE ON
set_global_assignment -name SLD_NODE_CREATOR_ID 110 -section_id lvds_decoded
set_global_assignment -name SLD_NODE_ENTITY_NAME sld_signaltap -section_id lvds_decoded
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_clk -to "feb_system:u_feb_system|feb_system_v4:u_qsys|feb_system_v4_data_path_subsystem:data_path_subsystem|lvds_outclock_clk" -section_id lvds_decoded

set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_RAM_BLOCK_TYPE=AUTO" -section_id lvds_decoded
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_NODE_INFO=805334532" -section_id lvds_decoded
