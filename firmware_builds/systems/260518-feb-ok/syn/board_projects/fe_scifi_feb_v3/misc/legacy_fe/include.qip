# Local generated helper-IP bundle for fe_block_v2 and the bring-up image.
# Mirrors the testplanphase5 generated/include.qip layout.

set_global_assignment -name VHDL_FILE [file join $::quartus(qip_path) "components_pkg.vhd"]
set_global_assignment -name QIP_FILE [file join $::quartus(qip_path) "ip/clk_ctrl_single/synthesis/clk_ctrl_single.qip"]
set_global_assignment -name QIP_FILE [file join $::quartus(qip_path) "a5/native_reset_tx.qip"]
set_global_assignment -name QIP_FILE [file join $::quartus(qip_path) "a5/ip_altera_xcvr_reset_control.qip"]
set_global_assignment -name QIP_FILE [file join $::quartus(qip_path) "a5/ip_altera_xcvr_native_av.qip"]
set_global_assignment -name QIP_FILE [file join $::quartus(qip_path) "a5/ip_alt_xcvr_reconfig.qip"]
set_global_assignment -name QIP_FILE [file join $::quartus(qip_path) "a5/fastlink_small.qip"]
