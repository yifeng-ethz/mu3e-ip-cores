# --- Daily-dated FEB v3 system, layout per rtl-file-structure skill ---
# Source of truth:
#   doc/  qsys_tcl/  script/  syn/<project files>  tb_int/<test sources>
#   .gitignore  README.md  top.vhd  top.qpf  top.qip
#
# Regeneratable / archival (never committed):
generated/
trash_bin/
tb_int/trash_bin/

# Quartus build outputs inside the board project (also regenerated)
syn/board_projects/*/db/
syn/board_projects/*/qdb/
syn/board_projects/*/incremental_db/
syn/board_projects/*/output_files*/
syn/board_projects/*/sta_debug_*/
syn/board_projects/*/timing_debug/
syn/board_projects/*/*.sof
syn/board_projects/*/*.pof
syn/board_projects/*/*.jic
syn/board_projects/*/*.rpt
syn/board_projects/*/*.summary
syn/board_projects/*/*.log
syn/board_projects/*/*.smsg
syn/board_projects/*/*.qws
syn/board_projects/*/generated/
syn/board_projects/*/bts/
syn/board_projects/*/ip/

# Simulator and analyzer work products (allow tb_int sources, drop runs)
tb_int/feb_swb_corun/build/
tb_int/feb_swb_corun/.old_tb_work/
tb_int/feb_swb_corun/report*/
tb_int/feb_swb_corun/uvm/work_feb_swb_uvm/
tb_int/feb_swb_corun/transcript
tb_int/feb_swb_corun/vsim.wlf
tb_int/**/work_*/
tb_int/**/transcript
tb_int/**/vsim.wlf
tb_int/**/*.vcd

# Tooling scratch
script/__pycache__/
script/**/__pycache__/
**/qverify_static*/
**/__pycache__/
