set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_stp_held_in_reset
set_global_assignment -name QIP_FILE top.qip
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE util/quartus/settings.tcl
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE assignments/fe_a5_base.tcl
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE assignments/fe_v2_scifi_pins.tcl

# Keep the STP debug revision on the same timing-effort profile as the
# loadable top revision (260518-feb-ok / LVDS-swap build).
set_global_assignment -name NUM_PARALLEL_PROCESSORS 16
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name ROUTER_TIMING_OPTIMIZATION_LEVEL MAXIMUM
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name PHYSICAL_SYNTHESIS_EFFORT NORMAL

set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Standard Edition"

set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008

# Held-in-reset triplet debug: 34-probe minimum-info STP per
# firmware_builds/systems/260518-feb-ok/tb_int/hist_v3/NEXT_STEPS_STP.md.
# Probes are mm_interconnect-side CSR signals for mu3e_lvds_controller_0
# (sanity), mutrig_injector_0, histogram_statistics_0, plus outclock /
# rst_controller_001.reset_out / monitor_reset_sync.reset_out as the
# clock+reset disambiguator. Sample clock = monitor_clock_125_in_clk.
set_global_assignment -name USE_SIGNALTAP_FILE "../../../script/signaltap/held_in_reset_triplet.stp"
set_global_assignment -name ENABLE_SIGNALTAP ON

set_global_assignment -name SLD_NODE_CREATOR_ID 110 -section_id held_in_reset_triplet
set_global_assignment -name SLD_NODE_ENTITY_NAME sld_signaltap -section_id held_in_reset_triplet
set_instance_assignment -name CONNECT_TO_SLD_NODE_ENTITY_PORT acq_clk -to "feb_system:u_feb_system|feb_system_v4:u_qsys|feb_system_v4_data_path_subsystem:data_path_subsystem|monitor_clock_125_in_clk" -section_id held_in_reset_triplet
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_RAM_BLOCK_TYPE=AUTO" -section_id held_in_reset_triplet
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_NODE_INFO=805334528" -section_id held_in_reset_triplet
set_global_assignment -name SLD_NODE_PARAMETER_ASSIGNMENT "SLD_POWER_UP_TRIGGER=0" -section_id held_in_reset_triplet
