# Qsys-generated output for the focus build.
# Only the Qsys-Tcl recipe (script/build_*_system.tcl) is tracked as the
# source of truth. Every artifact below is regenerated by qsys-generate
# and must not be hand-edited (per ~/CLAUDE.md "Hard rule — Qsys edits go
# through Tcl, never raw XML").

# Generated qsys system XML and SOPC info — any .qsys or .sopcinfo under syn/
syn/*.qsys
syn/*.sopcinfo

# Generated qsys synthesis / simulation trees (sibling of each .qsys)
syn/*_system/

# Quartus output and intermediate trees
syn/board_projects/*/db/
syn/board_projects/*/incremental_db/
syn/board_projects/*/output_files/
syn/board_projects/*/qdb/
syn/board_projects/*/.qsys_edit/
syn/board_projects/*/PLLJ_PLLSPE_INFO.txt
syn/board_projects/*/*.qws
syn/board_projects/*/*.cmp
syn/board_projects/*/*.summary
syn/board_projects/*/*.smsg
syn/board_projects/*/*.sld
syn/board_projects/*/*.jdi
syn/board_projects/*/*.pin
syn/board_projects/*/*.sof
syn/board_projects/*/*.rbf
syn/board_projects/*/*.rpt
syn/board_projects/*/*.txt

# IP cache from Platform Designer
ip/

# tb_int/ simulation work (mirrors tb/sim/ pattern)
tb_int/sim/
tb_int/work*/
tb_int/transcript
tb_int/*.wlf
