set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name QIP_FILE top.qip
set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Standard Edition"
set_global_assignment -name PROJECT_IP_REGENERATION_POLICY ALWAYS_REGENERATE_IP
set_global_assignment -name VHDL_SHOW_LMF_MAPPING_MESSAGES OFF
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE util/quartus/settings.tcl
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE assignments/fe_a5_base.tcl
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE assignments/fe_v2_scifi_pins.tcl

set_global_assignment -name ENABLE_SIGNALTAP OFF
set_global_assignment -name ENABLE_LOGIC_ANALYZER_INTERFACE OFF

set_global_assignment -name DEVICE 5AGXBA7D4F31C5

# Keep the MAX10 SPI launch path tight against the FE-board virtual-clock
# constraint without changing the MAX10 link RTL.
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to max10_spi_mosi
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to max10_spi_mosi
set_instance_assignment -name FAST_INPUT_REGISTER ON -to max10_spi_mosi
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to max10_spi_D1
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to max10_spi_D1
set_instance_assignment -name FAST_INPUT_REGISTER ON -to max10_spi_D1
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to max10_spi_D2
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to max10_spi_D2
set_instance_assignment -name FAST_INPUT_REGISTER ON -to max10_spi_D2
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to max10_spi_D3
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to max10_spi_D3
set_instance_assignment -name FAST_INPUT_REGISTER ON -to max10_spi_D3
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to max10_spi_csn
