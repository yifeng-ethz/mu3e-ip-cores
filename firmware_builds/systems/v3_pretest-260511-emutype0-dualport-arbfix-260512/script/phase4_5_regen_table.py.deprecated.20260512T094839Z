#!/usr/bin/env python3
"""phase4_5_regen_table.py -- Rebuild PHASE4_5_SWEEP_TABLE.md from sweep_evidence/.

Scans sweep_evidence/*/counters.json and regenerates the master markdown table.
Called automatically by phase4_5_sweep_runner.py after each row, but also
usable standalone:

  python3 phase4_5_regen_table.py

Output: doc/PHASE4_5_SWEEP_TABLE.md

Python 3.10 compatible.  ASCII only.
"""

from __future__ import annotations

import datetime as dt
import json
from pathlib import Path

BUILD_DIR    = Path(__file__).resolve().parents[1]
EVIDENCE_ROOT = BUILD_DIR / "sweep_evidence"
TABLE_PATH   = BUILD_DIR / "doc" / "PHASE4_5_SWEEP_TABLE.md"

PLAN_PATH    = BUILD_DIR / "script" / "phase4_5_sweep_plan.json"


def load_plan_rows() -> list[dict]:
    try:
        with open(PLAN_PATH, encoding="ascii") as f:
            plan = json.load(f)
        return plan.get("rows", [])
    except Exception:
        return []


def collect_evidence() -> dict[str, dict]:
    """Return {row_id: counters_dict} for all completed rows."""
    evidence: dict[str, dict] = {}
    if not EVIDENCE_ROOT.exists():
        return evidence
    for ev_dir in sorted(EVIDENCE_ROOT.iterdir()):
        if ev_dir.name.startswith("_"):
            continue   # skip _smoke and other internal dirs
        c_path = ev_dir / "counters.json"
        if not c_path.exists():
            continue
        try:
            with open(c_path, encoding="ascii") as f:
                d = json.load(f)
            row_id = ev_dir.name
            evidence[row_id] = d
        except Exception:
            pass
    return evidence


def safe_get(d: dict, *keys, default: str = "N/A") -> str:
    cur = d
    for k in keys:
        if not isinstance(cur, dict) or k not in cur:
            return default
        cur = cur[k]
    return str(cur)


def format_row(row_id: str, data: dict) -> str:
    row_cfg  = data.get("row", {})
    verdict  = data.get("verdict", {})
    snap     = data.get("snapshot_post", {})
    hist     = snap.get("histogram", {})

    lane_mask    = row_cfg.get("lane_mask",    "N/A")
    channel_mask = row_cfg.get("channel_mask", "N/A")
    rate         = row_cfg.get("rate_88fp",    "N/A")
    mode         = row_cfg.get("hit_mode",     "N/A")

    total_hits = hist.get("TOTAL_HITS", verdict.get("total_hits", "N/A"))
    underflow  = hist.get("UNDERFLOW_COUNT", verdict.get("underflow",  "N/A"))
    overflow   = hist.get("OVERFLOW_COUNT",  verdict.get("overflow",   "N/A"))

    pass_val   = verdict.get("pass")
    if pass_val is None:
        pf = "PENDING"
    elif pass_val:
        pf = "PASS"
    else:
        pf = "FAIL"

    ratio = verdict.get("ratio_to_prev")
    ratio_str = f"{ratio:.3f}" if isinstance(ratio, float) else "N/A"

    plot_rel = f"../sweep_evidence/{row_id}/plot.png"
    plot_cell = f"[plot]({plot_rel})"

    return (f"| {row_id} | {lane_mask} | {channel_mask} | {rate} | {mode} "
            f"| {total_hits} | {underflow} | {overflow} | {pf} | {ratio_str} "
            f"| {plot_cell} |")


def build_table() -> str:
    plan_rows = load_plan_rows()
    plan_ids  = [r.get("row_id", "") for r in plan_rows]
    evidence  = collect_evidence()

    now = dt.datetime.now().isoformat(timespec="seconds")
    total_rows   = len(plan_ids)
    done_rows    = sum(1 for rid in plan_ids if rid in evidence)
    pass_rows    = sum(
        1 for rid in plan_ids
        if evidence.get(rid, {}).get("verdict", {}).get("pass") is True
    )
    fail_rows    = sum(
        1 for rid in plan_ids
        if evidence.get(rid, {}).get("verdict", {}).get("pass") is False
    )

    lines = [
        "---",
        f"generated:   {now}",
        f"plan_rows:   {total_rows}",
        f"completed:   {done_rows}",
        f"pass:        {pass_rows}",
        f"fail:        {fail_rows}",
        f"pending:     {total_rows - done_rows}",
        "---",
        "",
        "# Phase 4.5 Sweep Master Table",
        "",
        (f"Auto-generated by `phase4_5_regen_table.py` on {now}. "
         f"Re-run `phase4_5_sweep_runner.py --all` to add more rows."),
        "",
        "## Status Summary",
        "",
        f"| Metric | Value |",
        f"|--------|-------|",
        f"| Plan rows | {total_rows} |",
        f"| Completed | {done_rows} |",
        f"| PASS | {pass_rows} |",
        f"| FAIL | {fail_rows} |",
        f"| Pending | {total_rows - done_rows} |",
        "",
        "## Per-Row Results",
        "",
        "| row_id | lane_mask | channel_mask | rate | mode | "
        "TOTAL_HITS | UNDERFLOW | OVERFLOW | PASS/FAIL | ratio_to_prev | plot |",
        "|--------|-----------|-------------|------|------|"
        "-----------|-----------|----------|-----------|---------------|------|",
    ]

    for rid in plan_ids:
        if rid in evidence:
            lines.append(format_row(rid, evidence[rid]))
        else:
            # Row not yet run -- show as pending
            plan_row = next((r for r in plan_rows if r.get("row_id") == rid), {})
            lm = plan_row.get("lane_mask", "N/A")
            cm = plan_row.get("channel_mask", "N/A")
            rate = plan_row.get("rate_88fp", "N/A")
            mode = plan_row.get("hit_mode", "N/A")
            lines.append(
                f"| {rid} | {lm} | {cm} | {rate} | {mode} "
                f"| — | — | — | PENDING | N/A | — |"
            )

    # Any rows in evidence but not in plan (manual or extra runs)
    extra_ids = [k for k in sorted(evidence.keys()) if k not in plan_ids]
    if extra_ids:
        lines += ["", "## Extra Rows (not in plan)"]
        lines.append("")
        lines.append(
            "| row_id | lane_mask | channel_mask | rate | mode | "
            "TOTAL_HITS | UNDERFLOW | OVERFLOW | PASS/FAIL | ratio_to_prev | plot |"
        )
        lines.append(
            "|--------|-----------|-------------|------|------|"
            "-----------|-----------|----------|-----------|---------------|------|"
        )
        for rid in extra_ids:
            lines.append(format_row(rid, evidence[rid]))

    lines.append("")
    lines.append(
        "> Table generated by `script/phase4_5_regen_table.py`. "
        "Source plan: `script/phase4_5_sweep_plan.json`. "
        "Evidence: `sweep_evidence/*/counters.json`."
    )
    lines.append("")
    return "\n".join(lines)


def main() -> int:
    TABLE_PATH.parent.mkdir(parents=True, exist_ok=True)
    content = build_table()
    TABLE_PATH.write_text(content, encoding="ascii")
    print(f"Regenerated: {TABLE_PATH}")
    return 0


if __name__ == "__main__":
    import sys
    sys.exit(main())
