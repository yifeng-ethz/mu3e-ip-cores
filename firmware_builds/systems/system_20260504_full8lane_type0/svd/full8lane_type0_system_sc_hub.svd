            </field>
          </fields>
        </register>
        <register>
          <name>DROPPED_HITS</name>
          <description>Live dropped-hit count caused by FIFO or queue overflow in the current interval. Resets at manual clear and at every interval pulse.</description>
          <addressOffset>0x38</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>value</name>
              <description>Current-interval dropped-hit count.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>COAL_STATUS</name>
