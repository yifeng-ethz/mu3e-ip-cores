              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>reserved</name>
              <description>Reserved, read as zero.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RESERVED3</name>
          <description>Reserved fourth CSR word. Reads return zero. Writes are ignored.</description>
          <addressOffset>0x0C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>value</name>
              <description>Reserved raw word.</description>
              <bitOffset>0</bitOffset>
