    <peripheral>
      <name>ONEWIRE_MASTER_CONTROLLER_0_CSR</name>
      <description>Direct control-path slave reached from sc_hub_cmd_pipe.m0. Qsys slave onewire_master_controller_0.csr is SC-hub-relative at 0x00011000 with compiled aperture size 0x0000002C. Compiled Qsys module onewire_master_controller_0 kind=onewire_master_controller version=26.2.1.428 from full8lane_control_path_subsystem.qsys. Version/identity parameters: VERSION_MAJOR=26, VERSION_MINOR=2, VERSION_PATCH=1, BUILD=428, VERSION_DATE=20260428, VERSION_GIT=0, IP_UID=1331121475, INSTANCE_ID=0. Source SVD onewire_temp_sense/script/onewire_master_controller.svd version 26.2.1. Relative 11-word 1-Wire controller CSR aperture with common Mu3e UID/META header.</description>
      <groupName>CONTROL_BOARD_MONITOR</groupName>
      <baseAddress>0x00011000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x0000002C</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>UID</name>
          <description>Common Mu3e software-visible IP identifier. Default is ASCII OWMC.</description>
          <addressOffset>0x00</addressOffset>
          <access>read-only</access>
          <resetValue>0x4F574D43</resetValue>
          <fields>
            <field>
              <name>ip_uid</name>
              <description>HDL parameter IP_UID.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>META</name>
          <description>Common read-multiplexed metadata word. Writes select the readback page: 0 VERSION, 1 VERSION_DATE, 2 VERSION_GIT, 3 INSTANCE_ID.</description>
          <addressOffset>0x04</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>selector</name>
              <description>Write page selector. 0 VERSION, 1 VERSION_DATE, 2 VERSION_GIT, 3 INSTANCE_ID.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>payload</name>
              <description>Readback payload for the selected metadata page. VERSION page encoding is MAJOR bits 31..24, MINOR bits 23..16, PATCH bits 15..12, BUILD bits 11..0.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SCRATCH</name>
          <description>Software scratch/readback word for CSR liveness tests.</description>
          <addressOffset>0x08</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>value</name>
              <description>Read/write scratchpad value, reset to zero.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAPABILITY</name>
          <description>1-Wire controller capability register.</description>
          <addressOffset>0x0C</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>n_dq_lines</name>
              <description>Number of 1-Wire DQ lines synthesized into this instance.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>n_sensors</name>
              <description>Reserved for future sensor-count reporting; currently reads zero.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>STATUS</name>
          <description>Line select and per-line control/status register. Reads return the selected line and its sticky error summary. Writes update sel_line and processor_go for the addressed line.</description>
          <addressOffset>0x10</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>sel_line</name>
              <description>Selected DQ line index for readback and processor_go writes.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>processor_go</name>
              <description>Enable or disable the background measurement processor for the selected line.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>reserved0</name>
              <description>Reserved, read as zero.</description>
              <bitOffset>17</bitOffset>
              <bitWidth>7</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>crc_err</name>
              <description>CRC error sticky flag for the selected line.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>init_err</name>
              <description>Initialization error sticky flag for the selected line.</description>
              <bitOffset>25</bitOffset>
