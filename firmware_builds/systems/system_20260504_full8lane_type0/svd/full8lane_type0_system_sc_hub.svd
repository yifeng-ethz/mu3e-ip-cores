      <description>Datapath-local slave expanded below the SC-hub mm_bridge.s0 aperture. Qsys slave data_path_subsystem_lvds_rx_controller_pro_0.csr is SC-hub-relative at 0x00029000 with compiled aperture size 0x00001000. Compiled Qsys module lvds_rx_controller_pro_0 kind=mu3e_lvds_controller version=26.2.1.506 from full8lane_type0_datapath.qsys. Version/identity parameters: VERSION_MAJOR=26, VERSION_MINOR=2, VERSION_PATCH=1, BUILD=1286, VERSION_DATE=539362566, VERSION_GIT=0, IP_UID=1280722003, INSTANCE_ID=0, N_LANE=9, N_ENGINE=1, ROUTING_TOPOLOGY=1, SCORE_WINDOW_W=10, SCORE_ACCEPT=8, SCORE_REJECT=2. The Qsys module version is the normalized LVDS IP release; Qsys shows BUILD=1286 and VERSION_DATE=539362566 because the Tcl build supplied hex literals BUILD=0x506 and VERSION_DATE=0x20260506. Standalone source SVD mu3e_lvds_controller/lvds_rx_controller_pro.svd version 26.2.1.0506 is generated from the same current SV RTL map. This system SVD emits the LVDS peripheral directly from mu3e_lvds_controller/rtl/mu3e_lvds_controller.sv so the SC-hub-specific Qsys version and address notes stay local to the grouped map.</description>
      <groupName>DATAPATH_LVDS</groupName>
      <baseAddress>0x00029000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x00001000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>UID</name>
          <description>Software-visible LVDS controller UID. Default ASCII "LVDS" (0x4C564453).</description>
          <addressOffset>0x00</addressOffset>
          <access>read-only</access>
          <resetValue>0x4C564453</resetValue>
          <fields>
            <field>
              <name>value</name>
              <description>Compile-time or integration-time LVDS UID word.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>META</name>
          <description>Read-multiplexed metadata word. Write page[1:0] before reading back: 0=VERSION, 1=VERSION_DATE, 2=VERSION_GIT, 3=INSTANCE_ID.</description>
          <addressOffset>0x04</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>page</name>
              <description>Selects the metadata read page.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>reserved</name>
              <description>Reserved, read as zero.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>30</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CAPABILITY</name>
          <description>Packed capability word for the compiled lane/engine/routing profile.</description>
          <addressOffset>0x08</addressOffset>
          <access>read-only</access>
          <fields>
            <field>
              <name>counter_count</name>
              <description>Number of per-lane counters exposed through the selected-lane counter window.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>n_lane</name>
              <description>Number of active LVDS lanes after RTL parameter clamping.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>n_engine</name>
              <description>Number of shared decode engines after RTL parameter clamping.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>score_window_w</name>
              <description>Score-window width used by the engine steering score saturators.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>routing_topology</name>
              <description>Compiled routing topology selector.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SYNC_PATTERN</name>
          <description>Training/control symbol accepted as the lane synchronization pattern. Writes are accepted only for RTL-recognized K28.5/K28.0/K23.7 encodings.</description>
          <addressOffset>0x0C</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>pattern</name>
              <description>10-bit synchronization symbol.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>10</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>reserved</name>
              <description>Reserved, read as zero.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>22</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>LANE_GO</name>
          <description>Per-lane enable mask, clipped by the compiled active-lane mask.</description>
          <addressOffset>0x10</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>lane_mask</name>
              <description>One bit per physical LVDS lane.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DPA_HOLD</name>
          <description>Per-lane DPA hold request mask, clipped by the compiled active-lane mask.</description>
          <addressOffset>0x14</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>lane_mask</name>
