          <access>read-write</access>
          <fields>
            <field>
              <name>value</name>
              <description>Raw 32-bit offset word.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MONITOR_SECONDS</name>
          <description>Monitor integration interval in seconds for the MuTRiG controller counter logic.</description>
          <addressOffset>0x08</addressOffset>
