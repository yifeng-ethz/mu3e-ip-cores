              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>META</name>
          <description>Read-multiplexed metadata word. Write 0=VERSION, 1=VERSION_DATE, 2=VERSION_GIT, 3=INSTANCE_ID before reading back.</description>
          <addressOffset>0x04</addressOffset>
          <access>read-write</access>
          <resetValue>0x1A0031AD</resetValue>
          <fields>
            <field>
              <name>page_select</name>
              <description>Write selector: 0=VERSION, 1=VERSION_DATE, 2=VERSION_GIT, 3=INSTANCE_ID.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>meta_payload</name>
