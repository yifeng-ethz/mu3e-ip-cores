          <wire name="feb_system:u_feb_system|full8lane_type0_system:u_qsys|full8lane_type0_system_data_path_subsystem:data_path_subsystem|full8lane_type0_system_data_path_subsystem_lvds_rx_controller_pro_0:lvds_rx_controller_pro_0|phy_ctrl_dpalock[8]" tap_mode="classic" />
