    <signal_set name="first_stage_chain">
      <!--Generated 2026/05/05 by Yifeng Wang for B014/B015 LVDS controller first-stage localization-->
      <!--Purpose: capture the LVDS super-core state/crossing controls plus first stages of the real-MuTRiG datapath-->
      <!--Clock: mu3e_lvds_controller outclock (~125 MHz) — same domain as all data-path IPs in data_path_subsystem-->
      <!--Trigger: aso_hit_type0_valid rising edge on mutrig_frame_deassembly_0 (first real hit boundary)-->
      <!--Depth: 2048 samples, ~88 bits/sample, ~22 kb on-chip BRAM-->
      <!--
      Probe path convention (Qsys-generated signal names are top-level wires in the data_path_subsystem Verilog):
        Group 01: feb_redriver_losn[8:0]   — top.vhd top-level signal, 9 bits
        Group 02: mu3e_lvds_controller wrapper PHY/core controls and lane-0 raw PHY symbol, 26 bits
        Group 03: lvds_rx_controller_pro_0 lane 0 decoded output: aso_decoded0_data[8:0] + aso_decoded0_error[2:0], 12 bits
        Group 04: mutrig_frame_deassembly_0 input wire: avalon_st_adapter_out_0_data[8:0] + avalon_st_adapter_out_0_valid, 10 bits
        Group 05: mutrig_frame_deassembly_0 output: _hit_type0_valid + _hit_type0_endofpacket + _hit_type0_data[15:0], 18 bits
        Group 06: mutrig_frame_deassembly_0 output channel: _hit_type0_channel[3:0], 4 bits
        Group 07: arb_hit_type0_supercore_0 lane_0 real input: asi_real_valid + asi_real_data[15:0], 17 bits
      Total: ~95 bits per sample, focused on LVDS lock/reset/bitslip crossing plus first-stage hit boundary
      -->
      <clock name="feb_system:u_feb_system|full8lane_type0_system:u_qsys|full8lane_type0_system_data_path_subsystem:data_path_subsystem|lvds_outclock_clk" polarity="posedge" tap_mode="classic" />
      <config pipeline_level="0" ram_type="AUTO" reserved_data_nodes="0" reserved_storage_qualifier_nodes="0" reserved_trigger_nodes="0" sample_depth="2048" trigger_in_enable="no" trigger_out_enable="no" />
      <top_entity />
      <signal_vec>
        <trigger_input_vec>
          <!--Trigger: mutrig_frame_deassembly_0 aso_hit_type0_valid rising edge-->
          <wire name="feb_system:u_feb_system|full8lane_type0_system:u_qsys|full8lane_type0_system_data_path_subsystem:data_path_subsystem|mutrig_frame_deassembly_0_hit_type0_valid" tap_mode="classic" />
          <!--Secondary trigger candidate: feb_redriver_losn[0] (LOS from DAB lane 0)-->
          <wire name="feb_redriver_losn[0]" tap_mode="classic" />
        </trigger_input_vec>
        <data_input_vec>
          <!--Group 01: feb_redriver_losn[8:0] — Loss-of-Signal from DAB re-driver (active-low, 1=signal OK, 0=LOS)-->
          <wire name="feb_redriver_losn[0]" tap_mode="classic" />
          <wire name="feb_redriver_losn[1]" tap_mode="classic" />
          <wire name="feb_redriver_losn[2]" tap_mode="classic" />
          <wire name="feb_redriver_losn[3]" tap_mode="classic" />
          <wire name="feb_redriver_losn[4]" tap_mode="classic" />
          <wire name="feb_redriver_losn[5]" tap_mode="classic" />
          <wire name="feb_redriver_losn[6]" tap_mode="classic" />
          <wire name="feb_redriver_losn[7]" tap_mode="classic" />
          <wire name="feb_redriver_losn[8]" tap_mode="classic" />
          <!--Group 02: mu3e_lvds_controller wrapper state/crossing probes (lane 0 and reset-link lane 8)-->
          <wire name="feb_system:u_feb_system|full8lane_type0_system:u_qsys|full8lane_type0_system_data_path_subsystem:data_path_subsystem|full8lane_type0_system_data_path_subsystem_lvds_rx_controller_pro_0:lvds_rx_controller_pro_0|phy_ctrl_plllock" tap_mode="classic" />
