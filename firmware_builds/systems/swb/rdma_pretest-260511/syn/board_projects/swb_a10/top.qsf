set_global_assignment -name QIP_FILE "top.qip"
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SOURCE_TCL_SCRIPT_FILE "scripts/settings.tcl"
set_global_assignment -name QIP_FILE "generated/include.qip"
set_global_assignment -name PRE_FLOW_SCRIPT_FILE "quartus_sh:util/quartus/pre_flow.tcl"
set_global_assignment -name SEED "1"
set_global_assignment -name ENABLE_SIGNALTAP ON
set_global_assignment -name USE_SIGNALTAP_FILE "rn001_opq_ingress_egress.stp"
set_global_assignment -name SIGNALTAP_FILE "rn001_opq_ingress_egress.stp"
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"
set_global_assignment -name VERILOG_MACRO "OPQ_USE_NATIVE_SV"
set_global_assignment -name VERILOG_MACRO "OPQ_N_LANE=4"
set_global_assignment -name VERILOG_MACRO "OPQ_N_SHD=128"
set_global_assignment -name VERILOG_MACRO "OPQ_N_HIT=255"
set_global_assignment -name VERILOG_MACRO "OPQ_TICKET_FIFO_DEPTH=1024"
set_global_assignment -name VERILOG_MACRO "OPQ_PAGE_RAM_DEPTH=65536"

set_global_assignment -name LAST_QUARTUS_VERSION "18.1.0 Standard Edition"
set_global_assignment -name ENABLE_LOGIC_ANALYZER_INTERFACE ON
